<div class="projectboard-app" data-projectboard-app data-cmid="{{cmid}}">
    <header class="projectboard-header">
        <div>
            <h2>{{title}}</h2>
            {{#objective}}<p class="projectboard-objective">{{objective}}</p>{{/objective}}
        </div>
        <div class="projectboard-toolbar">
            <label for="projectboard-switch">{{#strings}}{{selectboard}}{{/strings}}</label>
            <select id="projectboard-switch" data-board-select>
                {{#boards}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/boards}}
            </select>
            {{#canreports}}<a class="btn btn-outline-secondary" href="{{reporturl}}">{{#strings}}{{report}}{{/strings}}</a>{{/canreports}}
            {{#cangrade}}<button class="btn btn-outline-secondary" type="button" data-open-grade>{{#strings}}{{managegrade}}{{/strings}}</button>{{/cangrade}}
            {{#canmanagecolumns}}<button class="btn btn-outline-secondary" type="button" data-open-column>{{#strings}}{{addcolumn}}{{/strings}}</button>{{/canmanagecolumns}}
            {{#canadd}}<button class="btn btn-primary" type="button" data-open-create>{{#strings}}{{addtask}}{{/strings}}</button>{{/canadd}}
        </div>
    </header>
    <nav class="projectboard-filters" aria-label="{{#strings}}{{filter}}{{/strings}}">
        <label for="projectboard-search">{{#strings}}{{search}}{{/strings}}</label>
        <input id="projectboard-search" class="form-control" type="search" data-filter-search>
        <label for="projectboard-priority">{{#strings}}{{priority}}{{/strings}}</label>
        <select id="projectboard-priority" class="form-control" data-filter-priority>
            <option value="">{{#strings}}{{filter}}{{/strings}}</option>
            <option value="low">{{#strings}}{{low}}{{/strings}}</option>
            <option value="normal">{{#strings}}{{normal}}{{/strings}}</option>
            <option value="high">{{#strings}}{{high}}{{/strings}}</option>
            <option value="urgent">{{#strings}}{{urgent}}{{/strings}}</option>
        </select>
    </nav>
    <div id="projectboard-message" role="status" aria-live="polite"></div>
    <section id="projectboard-content" aria-label="{{#strings}}{{board}}{{/strings}}">
        {{#board}}{{> mod_projectboard/board}}{{/board}}
        {{^hasboards}}<p>{{#str}}noboard, mod_projectboard{{/str}}</p>{{/hasboards}}
    </section>
    <dialog id="projectboard-dialog" class="projectboard-dialog" aria-label="{{#strings}}{{taskedit}}{{/strings}}">
        <div id="projectboard-dialog-content"></div>
        <button class="btn btn-secondary" type="button" data-close-dialog>{{#strings}}{{cancel}}{{/strings}}</button>
    </dialog>
    <dialog id="projectboard-create-dialog" class="projectboard-dialog" aria-label="{{#strings}}{{addtask}}{{/strings}}">
        <h3>{{#strings}}{{addtask}}{{/strings}}</h3>
        <form data-form="task_create">
            <input type="hidden" name="boardid" value="{{selectedboardid}}" data-current-board>
            <label>{{#strings}}{{column}}{{/strings}}
                <select name="columnid" class="form-control" required>{{#columnoptions}}<option value="{{id}}">{{name}}</option>{{/columnoptions}}</select>
            </label>
            <label>{{#strings}}{{tasktitle}}{{/strings}}<input class="form-control" name="title" maxlength="255" required></label>
            <label>{{#strings}}{{description}}{{/strings}}<textarea class="form-control" name="description" rows="5"></textarea></label>
            <div class="projectboard-form-actions">
                <button class="btn btn-primary" type="submit">{{#strings}}{{save}}{{/strings}}</button>
                <button class="btn btn-secondary" type="button" data-close-dialog>{{#strings}}{{cancel}}{{/strings}}</button>
            </div>
        </form>
    </dialog>
    <dialog id="projectboard-column-dialog" class="projectboard-dialog">
        <h3>{{#strings}}{{addcolumn}}{{/strings}}</h3>
        <form data-form="column_create">
            <input type="hidden" name="columnid" value="0">
            <label>{{#strings}}{{columnname}}{{/strings}}<input name="name" class="form-control" required maxlength="120"></label>
            <label>{{#strings}}{{columncolour}}{{/strings}}<input type="color" name="colour" value="#64748b"></label>
            <label>{{#strings}}{{wiplimit}}{{/strings}}<input class="form-control" type="number" name="wiplimit" min="0" value="0"></label>
            <div class="projectboard-form-actions">
                <button class="btn btn-primary" type="submit">{{#strings}}{{save}}{{/strings}}</button>
                <button class="btn btn-secondary" type="button" data-close-dialog>{{#strings}}{{cancel}}{{/strings}}</button>
            </div>
        </form>
    </dialog>
    <dialog id="projectboard-grade-dialog" class="projectboard-dialog">
        <h3>{{#strings}}{{managegrade}}{{/strings}}</h3>
        <form data-form="grade_save">
            <input name="boardid" type="hidden" value="{{selectedboardid}}" data-current-board>
            <label>{{#strings}}{{assignees}}{{/strings}}<input class="form-control" name="userid" type="number" min="1"></label>
            <label><input name="override" type="checkbox" value="1"> {{#strings}}{{overridelabel}}{{/strings}}</label>
            <label>{{#strings}}{{grade}}{{/strings}}<input class="form-control" name="grade" type="number" min="0" step=".01" required></label>
            <label>{{#strings}}{{feedback}}{{/strings}}<textarea class="form-control" name="feedback" rows="4"></textarea></label>
            <div class="projectboard-form-actions">
                <button class="btn btn-primary" type="submit">{{#strings}}{{save}}{{/strings}}</button>
                <button class="btn btn-secondary" type="button" data-close-dialog>{{#strings}}{{cancel}}{{/strings}}</button>
            </div>
        </form>
        {{#cancriteria}}
        <hr>
        <h4>{{#strings}}{{criterionname}}{{/strings}}</h4>
        <form data-form="criterion_create">
            <label>{{#strings}}{{criterionname}}{{/strings}}<input class="form-control" name="name" maxlength="255" required></label>
            <label>{{#strings}}{{maxscore}}{{/strings}}<input class="form-control" name="maxscore" type="number" min=".01" step=".01" required></label>
            <button type="submit" class="btn btn-outline-primary">{{#strings}}{{save}}{{/strings}}</button>
        </form>
        {{#criteria}}
        <form data-form="criterion_score">
            <strong>{{name}} ({{maxscore}})</strong>
            <input type="hidden" name="criterionid" value="{{id}}">
            <input type="hidden" name="boardid" data-current-board value="{{selectedboardid}}">
            <label>{{#strings}}{{assignees}}{{/strings}}<input class="form-control" name="userid" type="number" min="1" required></label>
            <label>{{#strings}}{{grade}}{{/strings}}<input class="form-control" name="score" type="number" step=".01" min="0" max="{{maxscore}}" required></label>
            <button type="submit" class="btn btn-outline-primary">{{#strings}}{{save}}{{/strings}}</button>
        </form>
        {{/criteria}}
        {{/cancriteria}}
    </dialog>
</div>
